# ==============================================================================
# MovieFinder + Garuda AI Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with secrets to Git.

# Server Port
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Key (Required for live Garuda AI assistant)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/
# Free-tier supports Gemini 2.5 Flash / 1.5 Flash (15 RPM, 1M TPM, 1,500 RPD) at â‚¹0 cost.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred model identifier (defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. TMDB (The Movie Database) API Key (Required for live movie catalogue)
# ------------------------------------------------------------------------------
# Get your free developer API Key at: https://www.themoviedb.org/settings/api
# TMDB free tier permits standard non-commercial discovery with attribution at â‚¹0 cost.
# If not provided, MovieFinder seamlessly runs using our built-in verified movie dataset.
TMDB_API_KEY=your_tmdb_api_key_here

# ------------------------------------------------------------------------------
# 3. Client Frontend Settings (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
